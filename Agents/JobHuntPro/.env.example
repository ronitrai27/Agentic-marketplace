ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SERPAPI_KEY=
# Cheap models only
HAIKU_MODEL=claude-haiku-5-5
MINI_MODEL=gpt-4.1-mini
# Search window (seconds) and caps
JOBHUNT_MAX_SECONDS=75
JOBHUNT_MAX_SERP_CALLS=8

# --- Catelog server ---

PORT=3000
# sync = SSE on the same connection (default); async = 202 + poll /tasks/:id
JOBHUNT_MODE=sync
JOBHUNT_MAX_CONCURRENT=3
JOBHUNT_RATE_LIMIT=10
TRUST_PROXY=false
CATELOG_TELEMETRY_URL=
