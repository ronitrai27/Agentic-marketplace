{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outreach.input.v1",
  "title": "OutreachInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "tenant_id",
    "workflow_run_id",
    "agent_instance_id",
    "idempotency_key",
    "channel",
    "objective",
    "recipients",
    "config_version",
    "require_approval",
    "approval_granted"
  ],
  "properties": {
    "contract_version": { "const": "1.0" },
    "tenant_id": { "type": "string", "minLength": 1 },
    "workflow_run_id": { "type": "string", "minLength": 1 },
    "agent_instance_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "channel": { "enum": ["email"] },
    "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "language": { "type": "string", "minLength": 2, "maxLength": 20, "default": "en" },
    "tone": {
      "enum": [
        "professional",
        "warm",
        "concise",
        "friendly",
        "persuasive",
        "empathetic",
        "formal",
        "casual",
        "direct"
      ],
      "default": "professional"
    },
    "sender_name": { "type": ["string", "null"], "maxLength": 120 },
    "sender_email": { "type": ["string", "null"], "format": "email" },
    "sender_signature": { "type": ["string", "null"], "maxLength": 500 },
    "connection_id": { "type": ["string", "null"], "minLength": 1 },
    "recipients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/recipient" }
    },
    "config_version": { "type": "string", "minLength": 1 },
    "require_approval": { "type": "boolean" },
    "approval_granted": { "type": "boolean", "default": false },
    "dry_run": { "type": "boolean", "default": true },
    "attachments": {
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/$defs/attachment" }
    }
  },
  "$defs": {
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "content_type", "content_base64"],
      "properties": {
        "filename": { "type": "string", "minLength": 1, "maxLength": 180 },
        "content_type": { "type": "string", "minLength": 1, "maxLength": 120 },
        "content_base64": { "type": "string", "minLength": 1 }
      }
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipient_id"],
      "properties": {
        "recipient_id": { "type": "string", "minLength": 1 },
        "name": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"], "format": "email" },
        "locale": { "type": ["string", "null"] },
        "attributes": { "type": "object" }
      }
    }
  }
}
