APP_ENV=development
DRY_RUN=true
DATABASE_URL=postgresql://outreach:outreach_local_password@localhost:5434/agent_marketplace
PERSISTENCE_BACKEND=postgres
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_TOKEN=replace-with-a-random-secret
OUTREACH_TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
OUTREACH_STORE_PATH=./outreach.local.db
SARVAM_API_KEY=replace-in-secret-manager
SARVAM_LLM_MODEL=glm5.3-flash
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8010/api/v1/email-connections/callback
VITE_API_BASE_URL=http://localhost:8010
