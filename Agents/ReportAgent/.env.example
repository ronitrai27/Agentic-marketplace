# --- Instant mode (Ollama, runs locally / on your own server) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_NUM_CTX=8192

# --- Detailed mode (both required) ---
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
REPORT_HAIKU_MODEL=claude-haiku-5-5

# --- Catelog server ---
CATELOG_SECRET_KEY=
CATELOG_PUBLIC_KEY=
PORT=4000
REPORT_MAX_CONCURRENT=2
REPORT_RATE_LIMIT=10
# Set true only behind a trusted reverse proxy
TRUST_PROXY=false
CATELOG_TELEMETRY_URL=
