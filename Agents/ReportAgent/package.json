{
  "name": "report-agent",
  "version": "1.0.0",
  "description": "Report generator: instant (Ollama) or detailed (Claude Haiku + Gemini 2.5 Flash), delivered as PDF or DOCX",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "serve": "tsx src/server.ts",
    "build": "tsc",
    "serve:prod": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.94",
    "@ai-sdk/groq": "^4.0.74",
    "ai": "^7.0.159",
    "catelog": "^1.2.0",
    "docx": "^9.15.0",
    "dotenv": "^18.0.9",
    "fflate": "^0.8.3",
    "pdfkit": "^0.20.2",
    "unpdf": "^2.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
