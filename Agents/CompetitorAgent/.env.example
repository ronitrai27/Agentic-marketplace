# --- AI model (LiteLLM "provider/model" syntax — anything works) ---
OPENAI_API_KEY=sk-your-openai-api-key
MODEL=openai/gpt-4.1-mini
LLM_TEMPERATURE=0.2

# --- Web search: TinyFish (MCP) ---
# Key comes from TINYFISH_API_KEY, or is read from the TinyFish CLI config
# (~/.tinyfish/config.json) if you ran `npx @tiny-fish/cli connect`.
# Get one at https://agent.tinyfish.ai — no card needed.
TINYFISH_API_KEY=
TINYFISH_MCP_URL=https://agent.tinyfish.ai/mcp

# --- Server ---
PORT=3007
DATABASE_URL=postgresql://competitor:competitor_local_password@localhost:5436/competitor_agent

# --- Behaviour ---
MAX_COMPETITORS=5
MAX_SEARCH_RESULTS=6
MAX_FETCH_CHARS=6000
CREW_VERBOSE=false
