# ──────────────────────────────────────────────────────────────
#  AI India Patent Research Agent
#  Copy this file to .env  →  fill OPENAI_API_KEY  →  done.
# ──────────────────────────────────────────────────────────────

# ── 🔑 ONLY KEY YOU NEED ──────────────────────────────────────
# Get it free at: https://platform.openai.com → API Keys
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4.1-mini

# ── Server ────────────────────────────────────────────────────
PORT=3008

# ── Database (runs via Docker, no setup needed) ───────────────
DATABASE_URL=postgresql://patent_app:patent_app_pw@localhost:5437/patent_agent
DATABASE_OPS_URL=postgresql://patent_ops:patent_ops_pw@localhost:5437/patent_agent
TENANT_DEMO_ID=11111111-1111-1111-1111-111111111111

# ── Patent sources (both FREE, no signup needed) ──────────────
# 1. IPO/CGPDTM — Indian Patent Office public portal (auto)
IP_INDIA_SEARCH_URL=https://iprsearch.ipindia.gov.in
# 2. arXiv — research papers as prior art (auto)
ARXIV_ENABLED=true

# ── Everything below is already correct, don't touch ─────────
JURISDICTION=IN
LLM_CHAIN=openai
LLM_TEMPERATURE=0.1
FREE_MODE=true
EMBED_PROVIDER=hash
EMBED_DIM=384
PRICING_MODE=runtime
RUNTIME_RATE=0.04
MIN_RUN_FEE=0.10
MAX_RUN_FEE=1.50
PAYPAL_MODE=mock
MAX_CANDIDATES=50
MAX_CROSS_REFERENCED=10
MAX_CLAIMS=20
MAX_DRAFT_CHARS=20000
MAX_FETCH_CHARS=6000
RUNNER=inline
SHOW_TEAM_RAIL=true
