{
  "name": "ai-patent-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Patent & Prior-Art Research Agent — novelty scorecard + claim charting (LlamaIndex-style staged workflow, free-first)",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config web/vite.config.ts",
    "start": "tsx src/api/server.ts",
    "worker": "tsx src/jobs/worker.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.2.0",
    "mammoth": "^1.9.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
