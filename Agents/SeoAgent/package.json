{
  "name": "seo-agent",
  "version": "1.0.0",
  "description": "Enterprise-Grade Technical SEO & GEO Intelligence Platform powered by LangGraph.js and Temporal.io",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "worker": "tsx src/temporal/worker.ts",
    "test:temporal": "tsx src/temporal/run-test.ts",
    "test:guardrails": "tsx src/guardrails/test-guardrails.ts",
    "test:phases": "tsx src/test-phases.ts",
    "test:pillars": "tsx src/test-pillars.ts",
    "test:chat": "tsx src/test-chat.ts",
    "test:catelog": "tsx src/test-catelog.ts",
    "test:await": "tsx src/test-await-workflow.ts",
    "chat": "tsx src/cli.ts",
    "web": "tsx src/server.ts",
    "serve": "node dist/server.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@browserbasehq/sdk": "^2.22.0",
    "@langchain/core": "^1.2.20",
    "@langchain/langgraph": "^1.5.2",
    "@langchain/openai": "^1.6.3",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "catelog": "^1.1.0",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.8",
    "playwright": "^1.64.1",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
