# ==============================================================================
# Northflank Environment Variables for SeoAgent
# ==============================================================================

# Server Port (Default is 3000, Northflank injects PORT automatically)
PORT=3000
NODE_ENV=production

# Temporal Cloud Orchestration (Outbound TLS gRPC)
TEMPORAL_ADDRESS=hackerrank.odwdl.tmprl.cloud:7233
TEMPORAL_NAMESPACE=hackerrank.odwdl
TEMPORAL_TASK_QUEUE=seo-agent-queue
TEMPORAL_API_KEY=your_temporal_cloud_api_key_here

# Catelog Marketplace SDK (v1.0.6)
CATELOG_SECRET_KEY=cat_sec_live_c67619ac727df612b50a6cb1be786046929dc48bf8b8daeca44556e91e5be7e1
CATELOG_PUBLIC_KEY=cat_pub_live_21030fbabcbe3b8a1b8a09dd

# LLM & AI Providers
OPENAI_API_KEY=your_openai_api_key_here
OPENAPI_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# JEV Hydration & Guardrails
OPENROUTER_JEV=your_openrouter_key_here
JEV_MODEL=typesafe/jev-1.14

# Web Crawling & Verification Services
BROWSERBASE_API_KEY=your_browserbase_api_key_here
SERPAPI_KEY=your_serpapi_key_here
GOOGLE_PAGESPEED_KEY=your_google_pagespeed_api_key_here
FIRECRAWL_API_KEYS=your_firecrawl_api_key_here
