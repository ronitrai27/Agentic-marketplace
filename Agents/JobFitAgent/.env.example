# Required
ANTHROPIC_API_KEY=
# Cheap model for the whole run
JOBFIT_MODEL=
# Hard spend cap per run (USD)
JOBFIT_MAX_BUDGET_USD=
# Optional: OCR fallback for scanned/image-only PDFs (free tier at ocr.space). Text PDFs/DOCX never need it.
OCR_SPACE_API_KEY=

# --- Catelog server ---
CATELOG_SECRET_KEY=
CATELOG_PUBLIC_KEY=
PORT=3000
# async = 202 + poll /tasks/:id (recommended, runs take 20-60s); sync = SSE in the same connection
JOBFIT_MODE=async
JOBFIT_MAX_CONCURRENT=3
JOBFIT_RATE_LIMIT=10
# Set true only behind a trusted reverse proxy (reads X-Forwarded-For for per-client rate limits)
TRUST_PROXY=false
# Optional: your own telemetry collector receives {agentId, runId, status, telemetry} per run
CATELOG_TELEMETRY_URL=
