{
  "name": "catelog",
  "version": "1.1.0",
  "description": "Official TypeScript SDK for Marketplace Agent Protocol Specification (MAPS)",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "catelog": "./scripts/cli.js"
  },
  "files": [
    "dist",
    "scripts",
    "Catelog-TS.md",
    "Catelog-PY.md",
    "README.md",
    "USAGE.md",
    "DECISION.md",
    "LICENSE"
  ],
  "author": "ROX",
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "marketplace",
    "maps",
    "protocol",
    "langgraph",
    "openai",
    "paypal",
    "sdk"
  ],
  "scripts": {
    "build": "node scripts/clean.js && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/postbuild.js",
    "dev": "tsc --watch",
    "test": "tsx test/index.test.ts && tsx test/features.test.ts",
    "prepublishOnly": "npm run build",
    "postinstall": "node ./scripts/postinstall.js"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
