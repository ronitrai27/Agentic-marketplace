# Public URL of this MCP server (the OAuth "resource").
MCP_PUBLIC_URL=http://localhost:8787/mcp
PORT=8787

# Origin of the Next.js app that hosts the OAuth login + consent pages
# (it serves /.well-known/oauth-authorization-server). MCP clients are sent here.
AUTH_ISSUER=http://localhost:3000

# Convex HTTP actions origin (...convex.site) and the shared secret that the
# /mcp/introspect and /mcp/wallet routes check. Set the same value in Convex env.
CONVEX_SITE_URL=https://your-deployment.convex.site
MCP_BACKEND_SECRET=change-me
