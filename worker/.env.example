TEMPORAL_ADDRESS=<namespace>.<account>.tmprl.cloud:7233
TEMPORAL_NAMESPACE=<namespace>.<account>
TEMPORAL_API_KEY=
TEMPORAL_TASK_QUEUE=catelog-agent-runs
# Convex HTTP actions origin (ends in .convex.site)
CONVEX_SITE_URL=
# Must equal WORKER_SECRET in the Convex environment
WORKER_SECRET=
# RSA private key (base64 PKCS8). Decrypts agent signing keys; the matching public key is RUN_SECRET_PUBLIC_KEY in Convex.
RUN_SECRET_PRIVATE_KEY=
# Local development only: allow agents on localhost / private addresses
ALLOW_PRIVATE_AGENT_HOSTS=
